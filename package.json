{
  "name": "nova-install",
  "version": "1.0.0",
  "private": true,
  "description": "NovaInstall — Self-installing bilingual admin panel on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute nova-install-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute nova-install-db --remote --file=./migrations/0001_init.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.84.1"
  },
  "engines": {
    "node": ">=18"
  }
}
